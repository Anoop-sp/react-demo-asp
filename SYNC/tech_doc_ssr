import NextAuth from "next-auth";
import { NextAuthOptions } from "next-auth";
import { JWT } from "next-auth/jwt";
import { OAuthConfig } from "next-auth/providers/oauth";

/**
 * NextAuth.js configuration using a custom OAuth provider
 * to securely integrate with the organization's SSO.
 */
const authOptions: NextAuthOptions = {
  providers: [
    {
      id: "custom-sso", // Custom OAuth provider ID
      name: "Custom SSO",
      type: "oauth",
      wellKnown: "https://sso.org.com/.well-known/openid-configuration", // Well-known URL for OAuth discovery
      authorization: { params: { scope: "openid profile email" } }, // Requesting necessary scopes
      idToken: true, // Receiving an ID token after authentication
      checks: ["pkce", "state"], // Adding security checks
      clientId: process.env.SSO_CLIENT_ID, // Securely stored Client ID
      clientSecret: process.env.SSO_CLIENT_SECRET, // Securely stored Client Secret
    } as OAuthConfig<JWT>,
  ],
  callbacks: {
    /**
     * This callback stores the access token securely in the JWT.
     */
    async jwt({ token, account }) {
      if (account) {
        token.accessToken = account.access_token;
      }
      return token;
    },
    /**
     * This callback modifies the session object before returning it.
     */
    async session({ session, token }) {
      session.accessToken = token.accessToken;
      return session;
    },
  },
  session: {
    strategy: "jwt",
  },
  secret: process.env.NEXTAUTH_SECRET,
  pages: {
    signIn: "/auth/login",
  },
  cookies: {
    sessionToken: {
      name: "__Secure-next-auth.session-token",
      options: {
        httpOnly: true,
        secure: process.env.NODE_ENV === "production",
        sameSite: "strict",
        path: "/",
      },
    },
  },
};

export const handler = NextAuth(authOptions);
export { handler as GET, handler as POST };
